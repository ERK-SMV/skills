# Multi-stage Dockerfile for Odoo 18 using Docky convention
# This file follows Akretion's Docky structuring convention

# ============================================================================
# Stage 1: base
# Minimal Odoo image from Akretion's registry
# ============================================================================
FROM ghcr.io/akretion/odoo-docker:18.0-light-latest as base

# ============================================================================
# Stage 2: thisproject
# Add project-specific dependencies and configurations
# ============================================================================
FROM base as thisproject

# Switch to root user for package installation
USER root

# Install system-level dependencies
# These are required for building Python packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        python3-dev \
        python3-venv \
        python3-pip \
        git \
        curl \
        libpq-dev \
        libxml2-dev \
        libxslt1-dev \
        libldap2-dev \
        libsasl2-dev \
        libssl-dev \
        zlib1g-dev \
        libjpeg-dev \
        libfreetype6-dev \
        libffi-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python3 -m venv /venv
ENV PATH="/venv/bin:${PATH}"

# Install Python dependencies from requirements.txt
# Note: requirements.txt should be in the odoo/ directory
COPY odoo/requirements.txt /requirements.txt
RUN if [ -f /requirements.txt ]; then pip install --no-cache-dir -r /requirements.txt; fi

# ============================================================================
# Stage 3: test
# Test environment with demo data
# ============================================================================
FROM thisproject as test

# Switch to odoo user
USER odoo

# Copy Odoo source code
COPY --chown=odoo:odoo odoo/ /odoo

# Initialize test database
RUN /odoo/odoo-bin -i base -d test --without-demo=ALL --stop-after-init \
    && /odoo/odoo-bin -i web -d test --without-demo=ALL --stop-after-init \
    && /odoo/odoo-bin -u base -d test

# ============================================================================
# Stage 4: prod
# Production-ready image (no demo data, optimized)
# ============================================================================
FROM thisproject as prod

# Switch to odoo user
USER odoo

# Copy Odoo source code
COPY --chown=odoo:odoo odoo/ /odoo

# Initialize production database (without demo data)
RUN /odoo/odoo-bin -i base -d prod --without-demo=ALL --stop-after-init \
    && /odoo/odoo-bin -i web -d prod --without-demo=ALL --stop-after-init \
    && /odoo/odoo-bin -u base -d prod

# ============================================================================
# Default: use the thisproject stage for development
# ============================================================================
CMD ["/odoo/odoo-bin"]

# Alternative: use prod for production
# CMD ["/odoo/odoo-bin"]

# ============================================================================
# Build targets:
#   docker build --target base --tag my-odoo:base .
#   docker build --target thisproject --tag my-odoo:dev .
#   docker build --target test --tag my-odoo:test .
#   docker build --target prod --tag my-odoo:prod .
# ============================================================================
